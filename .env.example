# Copiar a backend/.env y reemplazar los valores de entorno local.
PORT=3000
NODE_ENV=development

# Conexion MySQL (XAMPP en desarrollo local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=meviplast_db

# Generar un valor aleatorio privado. Nunca usar este ejemplo como clave real.
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_largo
JWT_EXPIRES_IN=8h