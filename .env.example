# Copiar a backend/.env y reemplazar los valores de entorno local.
PORT=3000
NODE_ENV=development

# Conexion MySQL (XAMPP en desarrollo local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# En la nube (base MySQL administrada, ver docs/operations/despliegue-render.md): conexión cifrada y hora
# de la empresa. DB_SSL_CA lleva el certificado PEM (los saltos de línea como \n) o DB_SSL_CA_FILE su ruta.
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_CA_FILE=
# DB_TIME_ZONE=-05:00
# Servidor público: db:init sin cuentas ni datos DEMO, solo el admin con esta contraseña (mínimo 10 caracteres).
# DB_DEMO=false
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
DB_NAME=meviplast_db

# Generar un valor aleatorio privado. Nunca usar este ejemplo como clave real.
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_largo
JWT_EXPIRES_IN=8h

# Bloqueo de cuenta: intentos fallidos seguidos permitidos y minutos de bloqueo.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Nivel de los registros del servidor (una línea JSON por evento): error, warn, info, debug o silent.
LOG_LEVEL=info

# Archivos planos diarios del servidor y de los inicios de sesión (CR-016): servidor-AAAA-MM-DD.log y
# accesos-AAAA-MM-DD.log. Vacío: backend/logs. «off» los desactiva. Se borran solos después de LOG_RETENTION_DAYS.
LOG_DIR=
LOG_RETENTION_DAYS=90

# Retención de la auditoría (CR-016): npm run auditoria:archivar --prefix backend pasa los registros con más
# de AUDIT_RETENTION_MONTHS meses a auditoria-AAAA.csv y los borra de la tabla. Vacío: backend/archivo-auditoria.
AUDIT_RETENTION_MONTHS=12
AUDIT_ARCHIVE_DIR=

# Orígenes externos autorizados a llamar la API, separados por comas.
# Vacío: solo el mismo origen (Express sirve el panel). Ej.: http://localhost:5173
CORS_ORIGINS=

# SMTP para recuperación de contraseña/usuario. Usa una contraseña de aplicación.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false y una contraseña de
# aplicación de 16 caracteres (requiere la verificación en 2 pasos); la contraseña normal se rechaza.
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=